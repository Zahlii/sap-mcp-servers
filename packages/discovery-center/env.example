# SAP Discovery Center authentication, needed only for mission_step.
# Auth method: auto | password | certificate | interactive.
# auto uses SAP_USERNAME + SAP_PASSWORD first, then PFX_PATH + PFX_PASSPHRASE.
AUTH_METHOD=auto

# dotenv treats # as the start of a comment in unquoted values.
# Quote secrets that contain #, for example: SAP_PASSWORD="My#Pass"
SAP_USERNAME=your.email@company.com
SAP_PASSWORD="your_sap_password"
# When one email owns several SAP accounts, pick the one whose user ID starts with this prefix.
# Default S (S-user); P selects a partner P-user.
SAP_ACCOUNT_PREFIX=S

# Optional SAP Passport / client certificate auth.
# PFX_PATH=/absolute/path/to/sap-passport.pfx
# PFX_PASSPHRASE="your_certificate_passphrase"

# Default is headless browser login. Set HEADFUL=true only when MFA or manual login is required.
HEADFUL=false
MFA_TIMEOUT=180000

# Shared SAP SSO browser state, reused across the SAP MCP servers.
SAP_SSO_STORAGE_STATE=~/.sap-mcp/sso-storage-state.json

# Cookie cache lifetime in hours, and an optional explicit cache path.
MAX_JWT_AGE_H=12
# DISCOVERY_CENTER_TOKEN_CACHE_FILE=/absolute/path/to/discovery-center-token-cache.json

# Optional explicit .env path. Set this in the MCP client's env block to use a file instead of inline secrets.
# ENV_FILE=/absolute/path/to/.env
